# Generated by pnpm setup. Do not commit .env.
# Deploys the escrow and owns the provider ERC-8004 identities. Does not sign verdicts.
VERIFIER_PRIVATE_KEY=
# One key per verifier. These keys sign verdicts and do not send transactions.
VERIFIER_PRIVATE_KEY_1=
VERIFIER_PRIVATE_KEY_2=
VERIFIER_PRIVATE_KEY_3=
AGENT_PRIVATE_KEY=
PROVIDER_A_PRIVATE_KEY=
PROVIDER_B_PRIVATE_KEY=
PROVIDER_C_PRIVATE_KEY=
ROVA_GATEWAY_TOKEN=
# 1 makes Provider B return valid ETH/USD JSON with a stale timestamp.
# Ranking then uses price only, so the recorded demo starts with B.
DEMO_STALE=1
# Set FAULTY_VERIFIER to 1, 2, or 3 to make that process always vote PASS.
# Leave it unset for prove and showcase. Do not commit a real value.
